# Copy to .env (never committed). Only TMDB_TOKEN is required.
TMDB_TOKEN=            # TMDB → Settings → API → "API Read Access Token"
GOOGLE_CLIENT_ID=      # optional: Google sign-in
GOOGLE_CLIENT_SECRET=
ALERT_EMAIL=           # optional: monthly budget alert
DONATE_URL=            # optional: link for the "donate" card (e.g. Monobank jar)

# Optional: custom domain with a Route 53 hosted zone, e.g. movienight.click
DOMAIN_NAME=
# Optional: other addresses the app is served from, comma-separated (e.g. https://movienight-ucu.pages.dev)
EXTRA_APP_URLS=
